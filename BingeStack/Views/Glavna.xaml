<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BingeStack.Views.Glavna">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A90E2" Offset="0.0"/>
            <GradientStop Color="#D6EAF8" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*,Auto">

        <Border x:Name="TopNavDesktop"
                Grid.Row="0"
                BackgroundColor="White"
                Padding="20,10"
                IsVisible="False">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="30">

                <HorizontalStackLayout Spacing="10">

                    <Image Source="logo_pocetna.png"
                           HeightRequest="50"
                           WidthRequest="50"
                           VerticalOptions="Center"/>

                    <Label Text="BingeStack"
                           FontSize="22"
                           FontAttributes="Bold"
                           FontFamily="TimesNewRoman"
                           VerticalOptions="Center"
                           TextColor="Black"/>

                </HorizontalStackLayout>

                <Border Grid.Column="1"
                        BackgroundColor="#D6EAF8"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Kucica_Clicked"/>
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="8" Padding="10">

                        <Image Source="kucica.png"
                               HeightRequest="22"
                               WidthRequest="22"/>

                        <Label Text="Početna"
                               FontFamily="TimesNewRoman"
                               FontAttributes="Bold"
                               TextColor="#4A90E2"
                               VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </Border>

                <Border Grid.Column="2"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0"
                        Padding="10">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Plus_Clicked"/>
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="8">

                        <Image Source="plus.png"
                               HeightRequest="22"
                               WidthRequest="22"
                               Opacity="0.6"/>

                        <Label Text="Dodaj"
                               FontFamily="TimesNewRoman"
                               TextColor="Gray"
                               VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </Border>

                <Border Grid.Column="3"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0"
                        Padding="10">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Profil_Clicked"/>
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="8">

                        <Image Source="profil.png"
                               HeightRequest="22"
                               WidthRequest="22"
                               Opacity="0.6"/>

                        <Label Text="Profil"
                               FontFamily="TimesNewRoman"
                               TextColor="Gray"
                               VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </Border>

            </Grid>

        </Border>

        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20" Spacing="15">

                <VerticalStackLayout x:Name="MobileHeader"
                                     IsVisible="False"
                                     HorizontalOptions="Center"
                                     Spacing="0">

                    <Image Source="logo_pocetna.png"
                           HeightRequest="100"
                           WidthRequest="100"
                           HorizontalOptions="Center"/>

                    <Label Text="BingeStack"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontFamily="TimesNewRoman"
                           TextColor="Black"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <SearchBar x:Name="pretraga"
                           Placeholder="Pretraži filmove, knjige ili serije..."
                           SearchButtonPressed="Pretraga_Clicked"
                           FontFamily="TimesNewRoman"
                           BackgroundColor="White"
                           TextColor="Black"/>

                <Image Source="slika.png"/>

                <Border BackgroundColor="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="20">

                    <VerticalStackLayout Spacing="10">

                        <Label x:Name="nemaSadrzaja"
                               Text="Još nema dodanog sadržaja."
                               FontSize="16"
                               FontFamily="TimesNewRoman"
                               HorizontalOptions="Center"
                               TextColor="Gray"/>

                        <Border BackgroundColor="#EAF4FC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                Padding="20"
                                Margin="0,0,0,50">

                            <VerticalStackLayout Spacing="10">

                                <Label Text="🎯 Želim pogledati/ pročitati"
                                       FontSize="30"
                                       Margin="0,0,0,20"
                                       FontFamily="TimesNewRoman"/>

                                <CollectionView x:Name="listaZelja"
                                                IsVisible="False">

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <SwipeView>

                                                <SwipeView.RightItems>
                                                    <SwipeItems>
                                                        <SwipeItem Text="🗑️ Obriši"
                                                                   BackgroundColor="Red"
                                                                   Invoked="ObrisiSadrzaj"/>
                                                    </SwipeItems>
                                                </SwipeView.RightItems>

                                                <Border BackgroundColor="White"
                                                        Stroke="#D0D0D0"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 20"
                                                        Padding="15">

                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="SadrzajTapped"/>
                                                    </Border.GestureRecognizers>

                                                    <VerticalStackLayout>

                                                        <Label Text="{Binding Naziv}"
                                                               FontSize="18"
                                                               FontAttributes="Bold"
                                                               FontFamily="TimesNewRoman"/>

                                                        <Label Text="{Binding Vrsta}"
                                                               FontFamily="TimesNewRoman"/>

                                                        <Label Text="{Binding Status}"
                                                               FontFamily="TimesNewRoman"/>

                                                    </VerticalStackLayout>

                                                </Border>

                                            </SwipeView>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>

                                </CollectionView>

                            </VerticalStackLayout>

                        </Border>

                        <Border BackgroundColor="#EAF4FC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                Padding="20">

                            <VerticalStackLayout Spacing="10">

                                <Label Text="✅ Pogledano/ pročitano"
                                       FontSize="30"
                                       Margin="0,0,0,20"
                                       FontFamily="TimesNewRoman"/>

                                <CollectionView x:Name="listaZavrseno"
                                                IsVisible="False">

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <SwipeView>

                                                <SwipeView.RightItems>
                                                    <SwipeItems>
                                                        <SwipeItem Text="🗑️ Obriši"
                                                                   BackgroundColor="Red"
                                                                   Invoked="ObrisiSadrzaj"/>
                                                    </SwipeItems>
                                                </SwipeView.RightItems>

                                                <Border BackgroundColor="White"
                                                        Stroke="#D0D0D0"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 20"
                                                        Padding="15">

                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="SadrzajTapped"/>
                                                    </Border.GestureRecognizers>

                                                    <VerticalStackLayout>

                                                        <Grid ColumnDefinitions="*,Auto">

                                                            <Label Text="{Binding Naziv}"
                                                                   FontSize="18"
                                                                   FontAttributes="Bold"
                                                                   FontFamily="TimesNewRoman"
                                                                   VerticalOptions="Center"/>

                                                            <Label Grid.Column="1"
                                                                   Text="{Binding Zvjezdice}"
                                                                   TextColor="Goldenrod"
                                                                   FontSize="18"
                                                                   VerticalOptions="Center"/>

                                                        </Grid>

                                                        <Label Text="{Binding Vrsta}"
                                                               FontFamily="TimesNewRoman"/>

                                                        <Label Text="{Binding Status}"
                                                               FontFamily="TimesNewRoman"/>

                                                    </VerticalStackLayout>

                                                </Border>

                                            </SwipeView>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>

                                </CollectionView>

                            </VerticalStackLayout>

                        </Border>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <Border x:Name="BottomNav"
                Grid.Row="2"
                BackgroundColor="White"
                Padding="20,10"
                HeightRequest="60"
                IsVisible="False">

            <Grid ColumnDefinitions="*,*,*">

                <Border BackgroundColor="#D6EAF8"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 100">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Kucica_Clicked"/>
                    </Border.GestureRecognizers>

                    <Image Source="kucica.png"
                           HeightRequest="24"
                           WidthRequest="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

                </Border>

                <Image Grid.Column="1"
                       Source="plus.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       Opacity="0.6">

                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Plus_Clicked"/>
                    </Image.GestureRecognizers>

                </Image>

                <Image Grid.Column="2"
                       Source="profil.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       Opacity="0.6">

                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Profil_Clicked"/>
                    </Image.GestureRecognizers>

                </Image>

            </Grid>

        </Border>

        <VisualStateManager.VisualStateGroups>

            <VisualStateGroup>

                <VisualState x:Name="Mobile">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <Setter TargetName="TopNavDesktop" Property="IsVisible" Value="False"/>
                        <Setter TargetName="MobileHeader" Property="IsVisible" Value="True"/>
                        <Setter TargetName="BottomNav" Property="IsVisible" Value="True"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Desktop">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700"/>
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <Setter TargetName="TopNavDesktop" Property="IsVisible" Value="True"/>
                        <Setter TargetName="MobileHeader" Property="IsVisible" Value="False"/>
                        <Setter TargetName="BottomNav" Property="IsVisible" Value="False"/>
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>

        </VisualStateManager.VisualStateGroups>

    </Grid>

</ContentPage>