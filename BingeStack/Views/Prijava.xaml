<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BingeStack.Views.Prijava"
             Title="Prijava">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A90E2" Offset="0.0" />
            <GradientStop Color="#D6EAF8" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>

        <VerticalStackLayout VerticalOptions="Center"
                             Spacing="18"
                             Padding="20">

            <Image Source="logo_pocetna.png"
                   MaximumHeightRequest="100"
                   MaximumWidthRequest="100"/>

            <Label Text="Dobrodošli!"
                           HorizontalTextAlignment="Center"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontFamily="StilTekst1"/>

            <Border BackgroundColor="#80FFFFFF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 25"
                    Padding="20">

                <VerticalStackLayout Spacing="18">

                    <Entry Placeholder="E-mail"
                           x:Name="emailPolje"
                           FontSize="10"
                           TextColor="Black"
                           FontAttributes="Bold"
                           PlaceholderColor="DimGrey"/>

                    <Grid ColumnDefinitions="*,40">

                        <Entry Placeholder="Zaporka"
                               x:Name="zaporkaPolje"
                               FontSize="10"
                               TextColor="Black"
                               FontAttributes="Bold"
                               IsPassword="True"
                               PlaceholderColor="DimGrey"
                               Grid.Column="0"/>

                        <ImageButton Source="oko_otvoreno.png"
                                     BackgroundColor="Transparent"
                                     Grid.Column="1"
                                     Clicked="okoOtvoreno_Clicked"/>

                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <CheckBox x:Name="zapamtiMeCheckBox"
                                  Color="Black"
                                  VerticalOptions="Start"
                                  Margin="0,-20,0,0"
                                  Grid.Column="0"/>

                        <Label Text="Zapamti me"
                               FontSize="10"
                               FontFamily="StilTekst"
                               VerticalOptions="Start"
                               Margin="0,-3,0,0"
                               Grid.Column="1"/>

                        <Label Text="Zaboravili ste zaporku?"
                               FontSize="10"
                               TextDecorations="Underline"
                               HorizontalOptions="End"
                               Grid.Column="2">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ZaboravljenaZaporka_Tapped"/>
                            </Label.GestureRecognizers>

                        </Label>

                    </Grid>

                    <Button Text="PRIJAVA"
                            BackgroundColor="#4A90E2"
                            WidthRequest="100"
                            TextColor="Black"
                            FontSize="13"
                            FontFamily="StilTekst1"
                            CornerRadius="18"
                            HorizontalOptions="Center"
                            x:Name="prijavaGumb"
                            Clicked="prijavaGumb_Clicked"/>

                    <HorizontalStackLayout HorizontalOptions="Center"
                       Spacing="3">

                        <Label Text="Nemaš račun?"
           FontSize="11"
           TextColor="Black"
           FontFamily="StilTekst1"/>

                        <Label Text="Registracija"
           TextColor="Black"
           FontSize="11"
           FontFamily="StilTekst1"
           TextDecorations="Underline">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="registracijaGumb_Clicked"/>
                            </Label.GestureRecognizers>

                        </Label>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>